# Copy to .env and edit. Restart `npm run dev` after changing anything here.

# Port for the local dev server (npm run dev / npm run dev:watch).
# Loaded by dotenv-cli in the dev scripts, because Next itself ignores PORT inside .env files.
# If unset, Next uses 3000 and moves up to the next free port when it's busy.
PORT=

# Public URL of the site. Used for metadataBase, canonical URL, sitemap.xml, robots.txt and JSON-LD.
# Optional. If unset: falls back to VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL (set automatically on Vercel),
# then to the localhost URL hardcoded in src/lib/site.ts. Only set it when using a custom domain or running outside Vercel.
# Production deploys from GitHub Actions read it from the "production" environment variable of the same name
# (free Vercel domain first, e.g. https://my-portfolio.vercel.app; a custom domain later).
# A bare domain (your-domain.com) also works and is treated as https. Invalid values are ignored
# with a build warning. This is a public value (inlined into the client bundle): never put secrets in NEXT_PUBLIC_* variables.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
